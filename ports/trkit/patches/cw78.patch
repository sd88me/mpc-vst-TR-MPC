+void cr78_set_tap(cr78_engine_t *e, float *tap) { e->tap = tap; }
+
+/* TR-MPC patch: the post-voice stage (reverb, delay, master distortion, glue, volume) run once on summed buses. */
+void cr78_fx_stereo(cr78_engine_t *e, const float *dl, const float *dr, const float *send_r, const float *send_d,
+                     float *ol, float *orr, int frames)
+{
+    const int   mdist  = e->env[e->e_master_dist];
+    const float mdrive = e->potv[e->p_master_drive];
+    const float vol    = e->potv[e->p_volume];
+    const float comp   = e->potv[e->p_comp];
+    for(int i = 0; i < frames; ++i)
+    {
+        const float wet = cr78_verb_tick(&e->verb, send_r[i]) + cr78_dly_tick(&e->dly, send_d[i], e->sample_rate);
+        float l = dl[i] + wet, r = dr[i] + wet;
+        if(mdist > 0)
+        {
+            l = cr78_shape_st(l, mdrive, mdist - 1, e->crush_master);
+            r = cr78_shape_st(r, mdrive, mdist - 1, e->crush_master_r);
+        }
+        if(comp > 0.001f)
+        {
+            const float m = 0.5f * (l + r);
+            const float g = cr78_glue_tick(&e->glue, m, comp, e->sample_rate);
+            const float k = fabsf(m) > 1e-9f ? g / m : 1.0f;
+            l *= k; r *= k;
+        }
+        l *= vol; r *= vol;
+        ol[i]  = (l > -8.0f && l < 8.0f) ? l : 0.0f;
+        orr[i] = (r > -8.0f && r < 8.0f) ? r : 0.0f;
+    }
+}
