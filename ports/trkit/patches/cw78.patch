+/* TR-MPC patch: per-voice tap. With a tap set (NUM_VOICES x cr78_TAP_FRAMES floats, zeroed by the caller before each
+ * render) render() writes each voice's post-fader dry sample there and skips the reverb, delay, master stage and
+ * volume; the output stays silent. */
+#define CR78_TAP_FRAMES 128
+void cr78_set_tap(cr78_engine_t *e, float *tap);
+/* The post-voice stage on summed buses (dry L/R, reverb and delay send buses), as render() does it per kit. */
+void cr78_fx_stereo(cr78_engine_t *e, const float *dl, const float *dr, const float *send_r, const float *send_d,
+                     float *ol, float *orr, int frames);
+
 /* Both return 1 on a recognised key, 0 otherwise. */
